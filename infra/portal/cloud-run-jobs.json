{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "ccplaytv-portal-jobs",
    "labels": {
      "cloud.googleapis.com/location": "us-central1"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "autoscaling.knative.dev/minScale": "0",
          "autoscaling.knative.dev/maxScale": "2",
          "run.googleapis.com/cpu-throttling": "true"
        }
      },
      "spec": {
        "serviceAccountName": "REPLACE_RUNTIME_SERVICE_ACCOUNT",
        "containerConcurrency": 20,
        "timeoutSeconds": 60,
        "containers": [
          {
            "image": "REPLACE_IMAGE_DIGEST",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "env": [
              {
                "name": "CCPLAY_PORTAL_ENVIRONMENT",
                "value": "staging"
              },
              {
                "name": "CCPLAY_PORTAL_SERVICE_ROLE",
                "value": "jobs"
              },
              {
                "name": "CCPLAY_PORTAL_PROJECT_ID",
                "value": "REPLACE_PROJECT_ID"
              },
              {
                "name": "CCPLAY_PORTAL_PUBLIC_ORIGIN",
                "value": "https://REPLACE_PUBLIC_SERVICE_HOST"
              }
            ]
          }
        ]
      }
    }
  }
}
