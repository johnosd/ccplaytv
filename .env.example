# Lista M3U e Xtream para testes locais — copie para .env e preencha com
# dados reais. Este arquivo (.example) É versionado; .env não é
# (.gitignore). Nunca coloque credencial real aqui.
CCPLAY_PROBE_USER="usuario-exemplo"
CCPLAY_PROBE_PASS="senha-exemplo"
CCPLAY_PROBE_DNS="http://painel.exemplo:8080"
CCPLAY_PROBE_M3U="http://painel.exemplo:8080/get.php?username=usuario-exemplo&password=senha-exemplo&type=m3u_plus&output=ts"
CCPLAY_PROBE_EPG="http://painel.exemplo:8080/epg/usuario-exemplo/senha-exemplo"
